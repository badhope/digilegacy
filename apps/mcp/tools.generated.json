[
  {
    "name": "overview.get",
    "title": "读取平台概览",
    "description": "读取完成度、待办、审批数与运行态摘要。",
    "inputSchema": {
      "title": "EmptyInput",
      "type": "object",
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "app.overview"
    }
  },
  {
    "name": "audit.list",
    "title": "读取审计记录",
    "description": "按时间倒序分页读取平台审计哈希链，可按事件类型过滤；只读。",
    "inputSchema": {
      "title": "AuditListInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "audit.list"
    }
  },
  {
    "name": "assets.list",
    "title": "列出资产",
    "description": "按状态与关键词列出资产，返回游标分页结果。",
    "inputSchema": {
      "title": "AssetsListInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "archived",
            "all"
          ],
          "default": "active"
        },
        "q": {
          "type": "string",
          "maxLength": 120
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "assets.list"
    }
  },
  {
    "name": "assets.get",
    "title": "读取资产详情",
    "description": "按资产 ID 读取完整字段。",
    "inputSchema": {
      "title": "IdInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "assets.get"
    }
  },
  {
    "name": "plan.get",
    "title": "读取规划",
    "description": "读取持有人、继承人与触发链摘要。",
    "inputSchema": {
      "title": "EmptyInput",
      "type": "object",
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "plan.get"
    }
  },
  {
    "name": "policies.list",
    "title": "读取政策库",
    "description": "按分类与关键词读取平台继承政策、所需材料与办理流程。",
    "inputSchema": {
      "title": "PoliciesListInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "category": {
          "type": "string",
          "default": ""
        },
        "q": {
          "type": "string",
          "default": ""
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "policies.list"
    }
  },
  {
    "name": "policies.get",
    "title": "读取单条政策",
    "description": "按政策 ID 读取流程、材料、风险与溯源状态。",
    "inputSchema": {
      "title": "IdInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "policies.get"
    }
  },
  {
    "name": "policies.provenance.set",
    "title": "记录政策溯源",
    "description": "由人或 Agent 记录政策来源的核实状态、来源 URL 与备注；不修改政策正文。",
    "inputSchema": {
      "title": "PolicyProvenanceInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "source_cited",
            "verified",
            "disputed"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "default": ""
        },
        "note": {
          "type": "string",
          "default": ""
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "policies.provenance.set"
    }
  },
  {
    "name": "runs.list",
    "title": "列出 Agent 运行",
    "description": "读取运行状态、步骤数与成本摘要。",
    "inputSchema": {
      "title": "RunsListInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "active",
            "succeeded",
            "failed",
            "all"
          ],
          "default": "all"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "agent.runs.list"
    }
  },
  {
    "name": "agent.approvals.list",
    "title": "读取 Agent 审批队列",
    "description": "按状态读取 Agent 写操作审批记录；只读，不代替人工决定。",
    "inputSchema": {
      "title": "ApprovalListInput",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired",
            "all"
          ],
          "default": "pending"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "agent.approvals.list"
    }
  },
  {
    "name": "security.status",
    "title": "读取安全状态",
    "description": "读取锁定状态、恢复配置与密钥摘要，不含密钥本身。",
    "inputSchema": {
      "title": "EmptyInput",
      "type": "object",
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    "_meta": {
      "digilegacy/command": "security.status"
    }
  },
  {
    "name": "deliver.export",
    "title": "导出交付物",
    "description": "生成异步导出任务；只产出文件，不改业务最终态。",
    "inputSchema": {
      "title": "ExportInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locale"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "report",
            "checklist",
            "legal",
            "toolkit"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en-US"
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false
    },
    "_meta": {
      "digilegacy/command": "deliver.export"
    }
  }
]
