# DigiLegacy same-origin nginx example.
#
# Include this file inside an existing `http {}` block, or paste its contents
# there. Replace `root`, `server_name`, listen address and certificate paths.
# The console calls same-origin `/api`, so the SPA and API must share one origin.

upstream digilegacy_api {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 8080;
    server_name digilegacy.example.com;

    root /opt/digilegacy/web;
    index index.html;
    client_max_body_size 2m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Hashed assets are immutable; index.html must never be cached.
    # Repeat security headers where a location adds its own header: nginx
    # replaces inherited add_header directives when a location has any.
    location /assets/ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control "no-store";
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        proxy_pass http://digilegacy_api;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
