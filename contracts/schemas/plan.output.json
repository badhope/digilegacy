{
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "holder",
    "heirs",
    "trigger"
  ],
  "properties": {
    "holder": {
      "type": "object",
      "required": [
        "name",
        "updatedAt"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "heirs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "email",
          "phone"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "required": [
        "mode",
        "days",
        "status",
        "lastCheckIn",
        "nextCheckAt",
        "pausedUntil",
        "triggeredAt",
        "stage"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "days": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "lastCheckIn": {
          "type": "string"
        },
        "nextCheckAt": {
          "type": "string"
        },
        "pausedUntil": {
          "type": "string"
        },
        "triggeredAt": {
          "type": "string"
        },
        "stage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
