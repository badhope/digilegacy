{
  "title": "PlanHeirsInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "heirs"
  ],
  "properties": {
    "heirs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "maxLength": 80,
            "default": "heir"
          },
          "isExecutor": {
            "type": "boolean",
            "default": false
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "最终交付通知接收邮箱；可留空，留空时无法通过邮件送达。"
          },
          "phone": {
            "type": "string",
            "maxLength": 40,
            "description": "继承人联系电话，可选。"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
