{
  "title": "AssetsBulkInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "valueStatus": {
            "type": "string",
            "enum": [
              "market",
              "appraised",
              "insured",
              "unknown"
            ],
            "default": "market"
          },
          "identifier": {
            "type": "string",
            "maxLength": 120
          },
          "ownershipShare": {
            "type": "string",
            "maxLength": 120
          },
          "beneficiary": {
            "type": "string",
            "maxLength": 80
          },
          "beneficiaryContact": {
            "type": "string",
            "maxLength": 120
          },
          "credentialLocation": {
            "type": "string",
            "maxLength": 120
          },
          "expiresAt": {
            "type": "string",
            "maxLength": 10
          },
          "quantity": {
            "type": "string",
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 20
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
