{
  "title": "ExportInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "locale"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "report",
        "checklist",
        "legal",
        "toolkit"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "wait": {
      "type": "boolean",
      "default": true,
      "description": "true 同步生成；false 入队并返回 jobId"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
