{
  "title": "ConnectionTestResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "status",
    "latencyMs"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "connectionId": {
      "type": "string",
      "description": "被更新健康状态的连接 id"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "LLM 测试成功时返回的可用模型 id；不保存"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
