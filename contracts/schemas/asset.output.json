{
  "title": "Asset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "status",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "account",
        "file",
        "device",
        "domain",
        "subscription",
        "physical",
        "financial",
        "real_estate",
        "vehicle",
        "intellectual_property",
        "business",
        "virtual_item",
        "membership",
        "identity",
        "other"
      ]
    },
    "platform": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "value": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "valueStatus": {
      "type": "string",
      "enum": [
        "market",
        "appraised",
        "insured",
        "unknown"
      ]
    },
    "identifier": {
      "type": "string",
      "maxLength": 120,
      "description": "登录名、卡号后四位或证照编号；不存放口令。"
    },
    "ownershipShare": {
      "type": "string",
      "maxLength": 120,
      "description": "如 100%、50% 或 1/2。"
    },
    "beneficiary": {
      "type": "string",
      "maxLength": 80,
      "description": "继承人或指定接收人。"
    },
    "beneficiaryContact": {
      "type": "string",
      "maxLength": 120,
      "description": "电话或邮箱。"
    },
    "credentialLocation": {
      "type": "string",
      "maxLength": 120,
      "description": "密码管理器条目、保险柜或纸质文件位置。"
    },
    "expiresAt": {
      "type": "string",
      "maxLength": 10,
      "description": "YYYY-MM-DD，留空表示无期限。"
    },
    "quantity": {
      "type": "string",
      "maxLength": 40,
      "description": "可留空。"
    },
    "unit": {
      "type": "string",
      "maxLength": 20,
      "description": "份、股、台、件等。"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
