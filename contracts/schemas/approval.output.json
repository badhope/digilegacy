    "id",
    "runId",
    "tool",
    "status",
    "createdAt",
    "decidedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "decidedAt": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "objectKey": {
      "type": "string"
    },
    "diff": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
