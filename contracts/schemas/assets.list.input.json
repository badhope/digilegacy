{
  "title": "AssetsListInput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "all"
      ],
      "default": "active"
    },
    "q": {
      "type": "string",
      "maxLength": 120
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
