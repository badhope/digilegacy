{
  "title": "AssetMutation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "account",
        "file",
        "device",
        "domain",
        "subscription",
        "physical",
        "other",
        "financial",
        "real_estate",
        "vehicle",
        "intellectual_property",
        "business",
        "virtual_item",
        "membership",
        "identity"
      ]
    },
    "platform": {
      "type": "string",
      "maxLength": 80
    },
    "value": {
      "type": "string",
      "maxLength": 200
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "valueStatus": {
      "type": "string",
      "enum": [
        "market",
        "appraised",
        "insured",
        "unknown"
      ],
      "default": "market"
    },
    "identifier": {
      "type": "string",
      "maxLength": 120
    },
    "ownershipShare": {
      "type": "string",
      "maxLength": 120
    },
    "beneficiary": {
      "type": "string",
      "maxLength": 80
    },
    "beneficiaryContact": {
      "type": "string",
      "maxLength": 120
    },
    "credentialLocation": {
      "type": "string",
      "maxLength": 120
    },
    "expiresAt": {
      "type": "string",
      "maxLength": 10
    },
    "quantity": {
      "type": "string",
      "maxLength": 40
    },
    "unit": {
      "type": "string",
      "maxLength": 20
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
