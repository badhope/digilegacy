{
  "title": "AgentHarnessStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["planner", "runs", "approvals", "usage", "tools", "mcp", "skills"],
  "properties": {
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "source", "model", "endpointHost", "timeoutSecs"],
      "properties": {
        "configured": { "type": "boolean" },
        "source": { "type": "string", "enum": ["stored", "env", "local", "none"] },
        "model": { "type": "string" },
        "endpointHost": { "type": "string" },
        "timeoutSecs": { "type": "integer", "minimum": 0 }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "running", "waitingApproval", "failed"],
      "properties": {
        "total": { "type": "integer" },
        "running": { "type": "integer" },
        "waitingApproval": { "type": "integer" },
        "failed": { "type": "integer" }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending"],
      "properties": {
        "pending": { "type": "integer" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokensIn", "tokensOut", "costMicros", "priced"],
      "properties": {
        "tokensIn": { "type": "integer" },
        "tokensOut": { "type": "integer" },
        "costMicros": { "type": "integer" },
        "priced": { "type": "boolean" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "mcp", "write", "draft"],
      "properties": {
        "total": { "type": "integer" },
        "mcp": { "type": "integer" },
        "write": { "type": "integer" },
        "draft": { "type": "integer" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["servers", "enabled"],
      "properties": {
        "servers": { "type": "integer" },
        "enabled": { "type": "integer" }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "enabled"],
      "properties": {
        "total": { "type": "integer" },
        "enabled": { "type": "integer" }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
