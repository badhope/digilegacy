{
  "title": "AgentRunPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steps",
    "model",
    "planId",
    "usage"
  ],
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "default": {}
          }
        }
      },
      "maxItems": 20
    },
    "model": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokensIn",
        "tokensOut",
        "costMicros",
        "priced"
      ],
      "properties": {
        "tokensIn": {
          "type": "integer",
          "minimum": 0
        },
        "tokensOut": {
          "type": "integer",
          "minimum": 0
        },
        "costMicros": {
          "type": "integer",
          "minimum": 0
        },
        "priced": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
