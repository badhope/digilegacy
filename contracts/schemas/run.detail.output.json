{
  "title": "AgentRunDetail",
  "type": "object",
  "required": [
    "id",
    "status",
    "task",
    "steps",
    "toolsUsed",
    "rounds",
    "startedAt",
    "tokens",
    "tokensIn",
    "tokensOut",
    "costMicros",
    "usagePriced",
    "planId"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_approval",
        "succeeded",
        "failed",
        "rejected",
        "cancelled"
      ]
    },
    "task": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "status"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "pending_approval",
              "done",
              "failed",
              "rejected",
              "cancelled"
            ]
          },
          "result": {},
          "error": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "toolsUsed": {
      "type": "string"
    },
    "rounds": {
      "type": "integer"
    },
    "startedAt": {
      "type": "string"
    },
    "finalText": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tokensIn": {
      "type": "integer",
      "minimum": 0
    },
    "tokensOut": {
      "type": "integer",
      "minimum": 0
    },
    "costMicros": {
      "type": "integer",
      "minimum": 0
    },
    "usagePriced": {
      "type": "boolean"
    },
    "planId": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
