    "configured",
    "locked",
    "recoveryConfigured",
    "keySource",
    "lastBackupAt"
  ],
  "properties": {
    "configured": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean"
    },
    "recoveryConfigured": {
      "type": "boolean"
    },
    "keySource": {
      "type": "string",
      "enum": [
        "os",
        "passphrase",
        "unknown"
      ]
    },
    "lastBackupAt": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
