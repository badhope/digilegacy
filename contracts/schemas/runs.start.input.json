{
  "title": "AgentRunStart",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "steps"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "default": {}
          }
        }
      }
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20
    },
    "maxWriteSteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 5
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
