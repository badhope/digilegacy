{
  "title": "ConnectionTest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "llm",
        "policy",
        "smtp",
        "imap",
        "heartbeat",
        "webhook",
        "feishu",
        "wecom",
        "mcp"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "可选：已保存连接 id，测试后写入健康状态"
    },
    "token": {
      "type": "string",
      "maxLength": 4096,
      "description": "可选：尚未保存时用于模型发现的凭据；不会写入列表或审计"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
